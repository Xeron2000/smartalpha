[Unit]
Description=smartalpha pump.fun launch watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/smartalpha
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.local/bin/uv run smartalpha watch-launches
Restart=always
RestartSec=5
StandardOutput=append:%h/smartalpha/data/logs/watch_launches.log
StandardError=append:%h/smartalpha/data/logs/watch_launches.log

[Install]
WantedBy=default.target
