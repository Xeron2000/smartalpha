{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hypothesis DSL",
  "type": "object",
  "required": ["name", "description", "features", "entry_rule", "falsification_condition"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "description": { "type": "string", "minLength": 10 },
    "features": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "entry_rule": { "type": "string", "minLength": 1 },
    "exit_rule": { "type": "string" },
    "filters": { "type": "object" },
    "falsification_condition": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
