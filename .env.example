# Helius (required for watch-launches)
# https://dashboard.helius.dev → API Keys
HELIUS_API_KEY=

# Optional
SOLSCAN_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# GMGN: prefer file via `smartalpha gmgn-cookie import '...'`
GMGN_COOKIE_FILE=data/gmgn.cookie

# Optional Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Launch pipeline
LAUNCH_SETTLE_SEC=90
LAUNCH_PAIR_POLL_SEC=15
LAUNCH_MAX_BUYERS=12

# Entry (live strict)
SIGNAL_MIN_HOT_BUYERS=2
SIGNAL_MIN_LIQUIDITY_USD=5000
SIGNAL_ALLOW_UNKNOWN_LIQ=0

# Backtest / OOS
BACKTEST_SLIPPAGE_PCT=15
BACKTEST_IGNORE_STALE_LIQ=1
BACKTEST_STALE_LIQ_HOURS=48
BACKTEST_TP_PCT=100
BACKTEST_SL_PCT=30
BACKTEST_SCALE_HALF_PCT=100

# Session funders (watch / scan)
SESSION_MIN_GAIN_PCT=300
SESSION_MINT_LIMIT=15
SESSION_MIN_MINT_HITS=2
SESSION_MAX_BUYERS=15
SESSION_MIN_GRADE=medium
SESSION_REFRESH_SEC=1800

# Paper snapshots (seconds from signal t0)
PAPER_SNAPSHOT_DELAYS_SEC=0,90,180,300,900
