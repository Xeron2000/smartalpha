# Helius (required for watch-launches)
# https://dashboard.helius.dev → API Keys
HELIUS_API_KEY=

# Optional
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Launch pipeline
LAUNCH_SETTLE_SEC=90
LAUNCH_PAIR_POLL_SEC=15

# Entry (live strict)
SIGNAL_MIN_LIQUIDITY_USD=5000
SIGNAL_ALLOW_UNKNOWN_LIQ=0
SIGNAL_ALLOW_UNKNOWN_VELOCITY=0
SIGNAL_MIN_BUY_SELL_RATIO=1.5
SIGNAL_MAX_BUYER_SHARE=0.15
SIGNAL_MIN_VELOCITY=0.5

# Execution: paper is the only default. Canary is fail-closed and requires all values below.
EXECUTION_MODE=paper
EXECUTION_SIGNER_URL=
EXECUTION_SIGNER_TOKEN=
EXECUTION_CANARY_ARMED=0
EXECUTION_REQUIRE_PROVEN=1
EXECUTION_PROOF_PATH=data/prove_report.json
EXECUTION_TRADE_SIZE_SOL=0.05
EXECUTION_MAX_OPEN_POSITIONS=1
EXECUTION_MAX_DAILY_LOSS_SOL=0.10
EXECUTION_MAX_SLIPPAGE_PCT=5
EXECUTION_QUOTE_TTL_SEC=5
EXECUTION_POLL_SEC=5
EXECUTION_STOP_LOSS_PCT=20
EXECUTION_TP1_PCT=50
EXECUTION_TP2_PCT=100
EXECUTION_TP1_FRACTION=0.5
EXECUTION_TP2_FRACTION=0.3
EXECUTION_TRAIL_ACTIVATE_PCT=50
EXECUTION_TRAIL_DRAWDOWN_PCT=30
EXECUTION_MAX_HOLD_SEC=3600

# Paper snapshots (seconds from signal t0)
PAPER_SNAPSHOT_DELAYS_SEC=0,90,180,300,900
